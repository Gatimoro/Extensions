{
  "manifest_version": 3,
  "name": "The Watcher",
  "version": "6.9",
  "permissions": ["scripting","notifications","storage"],
  "host_permissions": ["http://192.168.11.66/ss/anna13.php"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": "eye.png"
  },
  "content_scripts": [
    {
      "matches": ["http://192.168.11.66/ss/anna13.php"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "128": "eye.png"
  }
}